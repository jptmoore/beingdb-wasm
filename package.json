{
  "name": "beingdb-wasm",
  "private": true,
  "license": "MIT",
  "description": "Query BeingDB facts in the web browser: the BeingDB query engine compiled to WebAssembly, for static deployments",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bundle": "node scripts/site.mjs bundle",
    "preview": "node scripts/site.mjs serve --dir",
    "dev": "node scripts/site.mjs dev",
    "tutorial": "node scripts/site.mjs build && node scripts/site.mjs serve",
    "build:tutorial": "node scripts/site.mjs build",
    "verify:tutorial": "node scripts/site.mjs verify",
    "test": "node scripts/site.mjs test",
    "deploy": "node scripts/site.mjs deploy",
    "update-demo-data": "node scripts/maintain.mjs update-demo-data",
    "update-runtime": "node scripts/maintain.mjs update-runtime"
  }
}
