; vendor/beingdb_runtime is a symlink to ../beingdb/lib/runtime (the portable
; BeingDB runtime), built from the local checkout rather than copied.
(vendored_dirs vendor)

; native/ is a separate dune root (Irmin-based exporter and parity tests).
(dirs :standard \ native)

; `dune build` also assembles the servable pages in _build/default/web and
; _build/default/tutorial.
(rule
 (alias default)
 (deps (alias_rec all) (alias web/page) (alias tutorial/page))
 (action (progn)))
